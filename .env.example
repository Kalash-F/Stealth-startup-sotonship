# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
LLM_MODEL=
COMTRADE_API_KEY=
# Classifier when a key is set: hierarchical (default, chapter -> heading -> HS6), flat, or keyword
CLASSIFIER=hierarchical
# Optional path to the full HS list (code,description). Default: data/reference/hs_nomenclature.csv, else hs6.csv
HS_NOMENCLATURE=
