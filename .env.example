# Copy to .env and fill in. Never commit .env.
# LLM provider: OpenRouter is used when OPENROUTER_API_KEY and OPENROUTER_MODEL are set,
# else Anthropic (ANTHROPIC_API_KEY + LLM_MODEL), else everything runs offline.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models (format vendor/model)
OPENROUTER_MODEL=
# Optional: your site URL, sent as HTTP-Referer for OpenRouter's app attribution
OPENROUTER_REFERER=
# Optional: a smaller, faster model for the one-line report summary (default: OPENROUTER_MODEL / LLM_MODEL)
SUMMARY_MODEL=
ANTHROPIC_API_KEY=
LLM_MODEL=
COMTRADE_API_KEY=
# Classifier when a key is set: hierarchical (default, chapter -> heading -> HS6), flat, or keyword
CLASSIFIER=hierarchical
# Optional path to the full HS list (code,description). Default: data/reference/hs_nomenclature.csv, else hs6.csv
HS_NOMENCLATURE=
