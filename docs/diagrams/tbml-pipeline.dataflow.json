  "cards": [
    {
      "dot": "emerald",
      "title": "Typed Contracts",
      "items": [
        "Each stage hands a frozen schema to the next (schemas.py, v1.0)",
        "pipeline.check() merges lines and bands into ReportLine rows",
        "Output is a review priority with reasons, never a fraud verdict"
      ]
    },
    {
      "dot": "amber",
      "title": "Degrade, Never Fail",
      "items": [
        "Extraction falls back: cached LLM, live LLM, layout parser, placeholder",
        "Unclassified lines keep None fields and price rules skip them",
        "Every fallback lands in Report.warnings"
      ]
    },
    {
      "dot": "slate",
      "title": "Offline by Default",
      "items": [
        "No API key: layout parser and keyword classifier run instead",
        "Bands come from local parquet; mock bands are marked is_mock",
        "USE_MOCKS=1 swaps extract and benchmark for fixtures"
      ]
    }
  ]
